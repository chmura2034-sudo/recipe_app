# Przykładowa konfiguracja. Skopiuj do .env i uzupełnij:
#   cp .env.example .env
#   chmod 600 .env
#
# Plik .env zawiera sekrety i nie trafia do repozytorium. Pliku .env.example nie uzupełniaj
# prawdziwymi wartościami - jest publiczny.
# Komentarze pisz w osobnych liniach: Docker i systemd czytają ten plik inaczej niż aplikacja.
# Linie zakomentowane pokazują wartości domyślne - odkomentuj tylko te, które chcesz zmienić.

# ---- Wymagane na produkcji ----

# production = bezpieczne ustawienia; development = praca lokalna przez http://, bez SECRET_KEY.
APP_ENV=production

# Min. 32 znaki, bez tego aplikacja produkcyjna nie wystartuje. Wygeneruj:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Liczba serwerów proxy przed aplikacją: 0 = brak, 1 = sam nginx.
# Źle ustawione psuje limit logowań per IP i wykrywanie HTTPS.
PROXY_COUNT=1

# Domeny serwisu, po przecinku. Inny nagłówek Host = błąd 400.
# Puste = brak sprawdzania (ostrzeżenie w logu). localhost i 127.0.0.1 są dopisywane zawsze.
TRUSTED_HOSTS=twoja-domena.pl

# Dane na stronie /polityka-prywatnosci: administrator (imię i nazwisko lub firma, adres) i kontakt.
PRIVACY_CONTROLLER=
PRIVACY_CONTACT_EMAIL=

# ---- Baza danych ----

# Domyślnie plik recipes.db w katalogu aplikacji. W Dockerze wartość ustawia docker-compose.
# Wdrożenie bez Dockera (patrz README, krok B3):
# DATABASE_URL=sqlite:////opt/recipe-app/data/recipes.db

# ---- Limity prób (logowanie, komentarze, oceny) ----

# Domyślne memory:// nie współdzieli liczników między workerami gunicorna.
# Na produkcji użyj Redisa. W Dockerze wartość ustawia docker-compose.
# Wdrożenie bez Dockera (patrz README, krok B2a):
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0

# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# LOGIN_RATE_LIMIT="10 per minute;30 per hour"
# COMMENT_RATE_LIMIT="5 per 10 minutes;20 per day"
# RATING_RATE_LIMIT="20 per hour"

# ---- Pliki i kopie zapasowe ----

# Limit żądania w MB. Po zmianie dostosuj też limit w nginx (patrz README).
# MAX_UPLOAD_MB=100
# Limit rozmiaru kopii po rozpakowaniu, w MB.
# BACKUP_MAX_UNCOMPRESSED_MB=300

# ---- Sesja i bezpieczeństwo ----

# Na produkcji domyślnie true (tylko HTTPS), w trybie development domyślnie false.
# SESSION_COOKIE_SECURE=true
# SESSION_LIFETIME_HOURS=12
# HSTS_SECONDS=31536000

# ---- Pozostałe ----

# Na produkcji domyślnie INFO, w trybie development domyślnie DEBUG.
# LOG_LEVEL=INFO

# Domyślne dane dla `flask create-admin`. Hasła lepiej nie trzymać w pliku:
# bez ADMIN_PASSWORD komenda zapyta o nie w terminalu.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Domyślne hasło dla komendy tworzącej redaktora (też lepiej podać je w terminalu).
# REDAKTOR_PASSWORD=
