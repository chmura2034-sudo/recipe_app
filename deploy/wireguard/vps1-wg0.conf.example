# /etc/wireguard/wg0.conf na VPS1 (edge/gateway, publiczne IP).
#
# WAŻNE: to jest tunel PUNKT-DO-PUNKTU między VPS1 i VPS2, nie pełny VPN.
# Nie przekierowujemy tu całego ruchu internetowego VPS2 — tylko łączymy
# ze sobą dwa serwery, żeby Nginx na VPS1 mógł dogadać się z aplikacją na VPS2.
# Dlatego NIE ma tu ani `iptables -t nat -A POSTROUTING ... MASQUERADE`,
# ani `net.ipv4.ip_forward=1` — VPS2 nie potrzebuje przez VPS1 wychodzić do internetu.
#
# Instalacja (Ubuntu/Debian):
#   sudo apt update && sudo apt install -y wireguard
#
# Wygeneruj klucze (osobno na VPS1):
#   wg genkey | tee /etc/wireguard/vps1-private.key | wg pubkey > /etc/wireguard/vps1-public.key
#   sudo chmod 600 /etc/wireguard/vps1-private.key
#
# Podmień PRIVATE_KEY_VPS1 na zawartość vps1-private.key,
# a PUBLIC_KEY_VPS2 na klucz publiczny wygenerowany NA VPS2 (patrz vps2-wg0.conf.example).

[Interface]
Address = 10.10.10.1/24
ListenPort = 51820
PrivateKey = PRIVATE_KEY_VPS1

[Peer]
# VPS2 (backend)
PublicKey = PUBLIC_KEY_VPS2
# Jeśli VPS2 ma stały publiczny adres/DNS, ustaw go tutaj — nawiąże połączenie z tej strony
# jako pierwszy i utrzyma tunel aktywny. Jeśli VPS2 jest za NAT-em bez stałego adresu,
# usuń tę linię — to VPS2 musi mieć wpisany Endpoint VPS1 (patrz vps2-wg0.conf.example).
Endpoint = ADRES_PUBLICZNY_VPS2:51820
# Jedyny adres, jaki VPS1 zaakceptuje jako pochodzący od tego peera —
# to właśnie to ogranicza tunel do połączenia punkt-do-punktu.
AllowedIPs = 10.10.10.2/32
PersistentKeepalive = 25
