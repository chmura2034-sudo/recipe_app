# Przykład: skopiuj do docker-compose.yml, uzupełnij .env (patrz .env.example).
#
# Użycie:
#   docker compose run --rm app flask db upgrade   # najpierw migracja schematu
#   docker compose run --rm app flask create-admin --username admin
#   docker compose up -d

services:
  app:
    build: .
    env_file: .env
    environment:
      # W kontenerze baza i zdjęcia żyją w wolumenach (patrz niżej), nie w warstwie obrazu.
      DATABASE_URL: sqlite:////data/recipes.db
    volumes:
      - db-data:/data
      - uploads-data:/app/static/uploads
    ports:
      # TYLKO localhost: ruch z internetu ma iść przez nginx (HTTPS) na hoście.
      # Docker dopisuje własne reguły iptables i OMIJA ufw - samo "8000:8000" wystawiłoby
      # gunicorna na wszystkich interfejsach po zwykłym HTTP (i pozwoliło podrobić
      # X-Forwarded-For, omijając limity prób logowania per IP).
      # Wariant z tunelem WireGuard (patrz README, opcja C): "10.10.10.2:8000:8000".
      - "127.0.0.1:8000:8000"
    restart: unless-stopped

volumes:
  db-data:
  uploads-data:
