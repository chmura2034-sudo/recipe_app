{"nodes": [{"id": "readme", "label": "Wielka Ksi\u0119ga Przepis\u00f3w README", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_role_administrator", "label": "Administrator role", "file_type": "rationale", "source_file": "README.md", "source_location": "L101", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full rights; recipes added/approved by admin are public immediately."}, {"id": "readme_role_redaktor", "label": "Redaktor (editor) role", "file_type": "rationale", "source_file": "README.md", "source_location": "L103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Editors create/edit own recipes, but all new content goes through the approval queue; no self-registration, accounts created by admin."}, {"id": "readme_approval_queue", "label": "Recipe approval queue (/admin/kolejka)", "file_type": "rationale", "source_file": "README.md", "source_location": "L104", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Content from editors is only publicly visible after admin acceptance; rejection carries a reason visible to the editor, who can fix and resubmit."}, {"id": "readme_ingredient_sections", "label": "Ingredient sections", "file_type": "rationale", "source_file": "README.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets ingredient lists be grouped under named headings (e.g. dough, cream); scaling covers all sections; stored in backup as ingredients_sections."}, {"id": "readme_recipe_scaling", "label": "Recipe scaling by servings or pan size/shape", "file_type": "rationale", "source_file": "README.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_backup_export_import", "label": "ZIP backup export/import (merge / skip_existing / wipe)", "file_type": "rationale", "source_file": "README.md", "source_location": "L125", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Portable recipes.json + images/ format independent of DB engine; orphaned images after wipe are a deliberate simplification."}, {"id": "readme_flask_migrate_migrations", "label": "Alembic/Flask-Migrate schema migrations", "file_type": "rationale", "source_file": "README.md", "source_location": "L155", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schema created via flask db upgrade instead of db.create_all() so schema evolution is versioned."}, {"id": "readme_xss_csp_protection", "label": "XSS protection: autoescape + CSP nonce, no inline handlers", "file_type": "rationale", "source_file": "README.md", "source_location": "L183", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "script-src 'self' 'nonce-...' without unsafe-inline so injected scripts cannot run even if autoescaping fails; behaviour moved to static/js/app.js via data-confirm/data-toggle-target attributes."}, {"id": "readme_sql_injection_protection", "label": "SQL injection protection via SQLAlchemy ORM", "file_type": "rationale", "source_file": "README.md", "source_location": "L178", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_safe_redirect", "label": "Safe post-login redirects (?next=)", "file_type": "rationale", "source_file": "README.md", "source_location": "L195", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents login link being used for phishing open redirects."}, {"id": "readme_timing_attack_protection", "label": "Timing-attack / username enumeration protection", "file_type": "rationale", "source_file": "README.md", "source_location": "L200", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dummy password hash check and identical error message so response time and text do not reveal account existence."}, {"id": "readme_logout_post_only", "label": "Logout only via POST with CSRF", "file_type": "rationale", "source_file": "README.md", "source_location": "L206", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Foreign pages cannot log users out with a link or <img src=/logout>."}, {"id": "readme_proxy_count", "label": "PROXY_COUNT trusted reverse proxy headers", "file_type": "rationale", "source_file": "README.md", "source_location": "L209", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "X-Forwarded-* headers are ignored unless proxies configured, preventing IP spoofing to bypass per-IP rate limits."}, {"id": "readme_zip_bomb_protection", "label": "Backup import zip-bomb protection", "file_type": "rationale", "source_file": "README.md", "source_location": "L214", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_strong_passwords", "label": "Strong password enforcement (MIN_PASSWORD_LENGTH, WEAK_PASSWORDS)", "file_type": "rationale", "source_file": "README.md", "source_location": "L218", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_image_sanitization", "label": "Uploaded image sanitization via Pillow re-encode", "file_type": "rationale", "source_file": "README.md", "source_location": "L222", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-encoding rather than trusting extension/MIME rejects polyglots, strips EXIF/GPS and trailing data, guards decompression bombs, and stores under random UUID names."}, {"id": "readme_login_rate_limiting", "label": "Login rate limiting and account lockout", "file_type": "rationale", "source_file": "README.md", "source_location": "L237", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two layers: per-IP Flask-Limiter and per-account lockout; lockout is a conscious trade-off (DoS by known username) mitigated by flask unlock-user."}, {"id": "readme_csrf_protection", "label": "CSRF protection on all forms (Flask-WTF)", "file_type": "rationale", "source_file": "README.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_production_deployment", "label": "Production deployment (Docker or gunicorn+nginx+systemd)", "file_type": "concept", "source_file": "README.md", "source_location": "L253", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_cron_export_backup", "label": "Cron backups via flask export-backup", "file_type": "rationale", "source_file": "README.md", "source_location": "L302", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backups should be kept off-server; CLI works without browser session and writes file with 600 permissions."}, {"id": "readme_env_variables", "label": "Environment variables (.env, APP_ENV, SECRET_KEY...)", "file_type": "concept", "source_file": "README.md", "source_location": "L58", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defaults to production mode which refuses to start without a valid SECRET_KEY."}], "edges": [{"source": "readme", "target": "readme_role_administrator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "readme_role_redaktor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme", "target": "readme_approval_queue", "relation": "references", "confidence": "EXTRACTED"